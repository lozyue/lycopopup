{
  "name": "lyco-popup",
  "displayName": "LycoPopup",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "module": "./dist/lyco-popup.min.js",
  "types": "./dist/lyco-popup.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lyco-popup.d.ts",
      "import": "./dist/lyco-popup.min.js"
    }
  },
  "author": {
    "name": "Loyuri",
    "url": "https://loyuri.top/"
  },
  "scripts": {
    "build": "npm run build:types && npm run build:js",
    "build:js": "node ./scripts/build.mjs",
    "install-lib": "node ./scripts/install-local.cjs",
    "build:types": "tsc -p tsconfig.types.json && tsc-alias -p tsconfig.types.json",
    "ts-compile": "tsc --project tsconfig.types.json --watch",
    "preview:(playground)": "http-server --port 8077"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.1.4",
    "html-minifier-terser": "^7.2.0",
    "rollup": "^4.45.1",
    "rollup-plugin-dts": "^6.2.1",
    "tslib": "^2.8.1",
    "typescript": "^5.8.3"
  }
}
